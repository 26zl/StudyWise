# StudyWise — Docker Compose miljøvariabler
# Kopier til .env i prosjektrot: cp docker.env.example .env
# Fyll inn verdier fra Clerk Dashboard og Cloudflare Turnstile.
# Backend-spesifikke variabler (MONGO_URI, REDIS_URL osv.) leses fra backend/.env
# og overstyres av docker-compose.yml for container-nettverk.

# --- Clerk (påkrevd) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk-webhooks er backend-spesifikke og settes i backend/.env.
# Uten CLERK_WEBHOOK_SECRET testes ikke user.deleted-webhook fullt lokalt.

# --- Cloudflare Turnstile (valgfritt) ---
# Begge flagg må stå likt. false = helt av i både frontend og backend for lokal Docker.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
TURNSTILE_ENABLED=false

# Følgende trengs kun når Turnstile-flaggene settes til true:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_AUTH_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_TURNSTILE_SECRET_KEY=
AUTH_TURNSTILE_GATE_SECRET=

# --- Clerk-ruting (standardverdier fungerer vanligvis) ---
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- MongoDB (lokale Docker-credentials, brukes av docker-compose.yml) ---
# Standardverdier fungerer rett ut av boksen. Endre kun hvis du vil bruke andre credentials.
# MONGO_INITDB_ROOT_USERNAME=studywise
# MONGO_INITDB_ROOT_PASSWORD=studywise-dev

# --- Intern API-URL for Docker (ikke endre med mindre du vet hva du gjør) ---
# I Docker må frontend bruke Compose-servicenavnet `backend`, ikke localhost.
# `localhost:4000` peker på frontend-containeren selv og gir proxy-feil.
# DOCKER_INTERNAL_API_URL=http://backend:4000
