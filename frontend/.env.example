# Frontend – alle variabler under er påkrevd (validateFrontendEnv ved oppstart)
# 
# Frontend bruker Next.js rewrites for API-kall; INTERNAL_API_URL brukes i rewrites.
# `pnpm build` validerer Clerk-oppsett, og Docker Compose må få de samme Clerk-variablene både i build args og runtime env.

# Clerk (innlogging, profil, 2FA). Hent fra Clerk Dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Backend-URL for rewrites. Lokal dev: http://localhost:4000. Docker: http://backend:4000.
INTERNAL_API_URL=http://localhost:4000

# Clerk sign-in/sign-up URLs (påkrevd av Clerk docs og validering)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Datadog RUM – aktiveres når applicationId og clientToken er satt
# Hent fra Datadog: Digital Experience → RUM Applications → din app (studywise-frontend)
# next.config.js mapper DD_RUM_* → NEXT_PUBLIC_DD_RUM_* ved build-tid, slik at begge varianter fungerer.
# Vercel: Sett DD_RUM_APPLICATION_ID og DD_RUM_CLIENT_TOKEN, deretter trigger ny build.
# Lokal: Bruk NEXT_PUBLIC_* eller DD_RUM_* (begge fungerer).
# DD_RUM_APPLICATION_ID=<uuid>
# DD_RUM_CLIENT_TOKEN=<token>
# DD_RUM_SITE=us5.datadoghq.com
# NEXT_PUBLIC_DD_RUM_APPLICATION_ID=<uuid>
# NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=<token>
# NEXT_PUBLIC_DD_SITE=us5.datadoghq.com

# ─── Turnstile (påkrevd i både dev og prod) ───
# Cloudflare Turnstile – client-side site key fra Turnstile Dashboard
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# Egen Turnstile-widget for auth-sidene (sign-in/sign-up)
NEXT_PUBLIC_AUTH_TURNSTILE_SITE_KEY=0x...

# Delt hemmelighet for signert auth-cookie (må matche backend)
AUTH_TURNSTILE_GATE_SECRET=<generer-med-crypto.randomBytes(32).toString('hex')>
