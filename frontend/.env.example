# Frontend Environment Variables
#
# Frontend bruker Next.js rewrites for API-kall.
# Client-side kode bruker relative paths (/api/...) som automatisk
# sendes til backend via rewrites i next.config.js.
#
# Lokal utvikling: Ingen env-variabler nødvendig (default: localhost:4000)
# Docker/Cloud Run: INTERNAL_API_URL settes automatisk

# VALGFRI: Kun for Docker/produksjon - settes vanligvis i docker-compose/Cloud Run
# INTERNAL_API_URL=http://backend:4000

# Datadog RUM (Real User Monitoring) – valgfritt; aktiveres når begge er satt
# Hent applicationId og clientToken fra Datadog: Digital Experience → RUM Applications → New Application (f.eks. studywise-frontend, type JS/React)
# NEXT_PUBLIC_DD_RUM_APPLICATION_ID=<uuid>
# NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=<token>
# NEXT_PUBLIC_DD_SITE=us5.datadoghq.com
