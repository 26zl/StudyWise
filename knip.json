{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "cloudflare/worker.js"],
      "ignoreDependencies": [
        "@rolldown/binding-win32-x64-msvc",
        "remark-preset-lint-recommended",
        "lint-staged",
        "wrangler"
      ]
    },
    "common": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "backend": {
      "entry": ["src/datadog.ts"],
      "project": ["src/**/*.ts"]
    },
    "frontend": {
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/route.ts",
        "app/**/loading.tsx",
        "app/**/error.tsx",
        "app/**/not-found.tsx"
      ],
      "project": ["app/**/*.{ts,tsx}", "*.{ts,tsx,js,mjs}"],
      "ignoreDependencies": ["katex"]
    },
    "docs": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["vue"]
    },
    "tests": {
      "entry": ["run.ts", "auth/*.ts", "ki/*.ts", "canvas/*.ts", "**/*.spec.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["tsx"]
    }
  },
  "ignoreExportsUsedInFile": true
}
