{
  "name": "studywise",
  "description": "STUDYWISE. En KI-basert studieassistent for høyere utdanning med integrasjon mot Canvas Instructure. Bachelor i IT 2026.",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --raw \"pnpm dev:backend\" \"wait-on tcp:4000 && pnpm dev:frontend\" \"pnpm dev:docs\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:common": "pnpm --filter common typecheck --watch",
    "kill:dev": "node scripts/kill-dev.mjs",
    "lint": "pnpm -r lint",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint:backend": "pnpm --filter backend lint",
    "typecheck": "pnpm -r typecheck",
    "typecheck:frontend": "pnpm --filter frontend typecheck",
    "typecheck:backend": "pnpm --filter backend typecheck",
    "typecheck:common": "pnpm --filter common typecheck",
    "build": "pnpm --filter common build && pnpm --filter backend build && pnpm --filter frontend build && pnpm --filter docs build",
    "build:common": "pnpm --filter common build",
    "build:frontend": "pnpm --filter common build && pnpm --filter frontend build",
    "build:backend": "pnpm --filter common build && pnpm --filter backend build",
    "build:docs": "pnpm --filter docs build",
    "start": "sh ./start.sh",
    "start:parallel": "pnpm --parallel start:frontend start:backend",
    "start:frontend": "pnpm --filter frontend start",
    "start:backend": "pnpm --filter backend start",
    "update": "pnpm -r update",
    "update:frontend": "pnpm --filter frontend update",
    "update:backend": "pnpm --filter backend update",
    "update:common": "pnpm --filter common update",
    "update:docs": "pnpm --filter docs update",
    "outdated": "pnpm -r outdated",
    "clean:all": "node scripts/clean.mjs",
    "clean:install": "node scripts/clean.mjs && pnpm install && pnpm -r update && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "docx": "^9.6.0",
    "kill-port": "^2.0.1",
    "markdownlint-cli": "^0.47.0",
    "rimraf": "^6.1.3",
    "wait-on": "^9.0.4"
  },
  "pnpm": {
    "overrides": {
      "glob@<8": ">=8.0.0",
      "inflight": "npm:@node-rs/inflight@latest",
      "lodash.get": "npm:lodash@^4.17.21",
      "lodash.isequal": "npm:lodash@^4.17.21",
      "esbuild": "^0.25.0",
      "markdown-it": ">=14.1.1",
      "qs": ">=6.14.2",
      "minimatch": ">=10.2.1"
    },
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "bcrypt",
      "esbuild",
      "sharp",
      "tesseract.js",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
