# Backend – alle variabler under er påkrevd (validateEnv ved oppstart)

PORT=4000
# CORS/CSRF/Clerk authorizedParties: kommaseparert liste uten mellomrom.
# I dev med Swagger: WEB_ORIGINS=http://localhost:3000,http://localhost:4000
WEB_ORIGINS=http://localhost:3000
# Tillatt host i produksjon (blokkerer direkte tilgang via Heroku-subdomain).
# Påkrevd i produksjon — settes til Cloudflare-frontet hostname.
# API_HOST=api.studwize.page
# Antall betrodde proxy-hopp foran appen.
# For Cloudflare -> Heroku er dette typisk 2.
# Påkrevd i produksjon.
# TRUST_PROXY_HOPS=2
# Cloudflare-only håndhevelse: krever at peer-IP fra siste X-Forwarded-For-hop
# er i Cloudflares offisielle IPv4/IPv6-ranges, og at CF-Connecting-IP er satt.
# Forhindrer at backend nås direkte via Heroku-DNS-targetet (omgående Cloudflares
# WAF, rate-limit og bot management). Aktiver i produksjon. Kun /health og /ready
# er unntatt for Heroku liveness/readiness — /health/dependencies er admin-only
# og bypasser ikke sjekken. Frontend (Vercel) må samtidig peke INTERNAL_API_URL
# til https://api.studwize.page, ellers blokkeres SSR/rewrite-trafikken også.
# ENFORCE_CLOUDFLARE_ONLY=true
# Ekstra interne hostnames som også skal godtas av host-valideringen.
# INTERNAL_HOSTS=backend.internal,worker.internal
# Må inneholde /studywise (validateEnv)
MONGO_URI=mongodb://localhost:27017/studywise
REDIS_URL=redis://localhost:6379

# Sikkerhet / Auth (Clerk-only). Hent fra Clerk Dashboard: API Keys → Secret key (minst 32 tegn)
CLERK_SECRET_KEY=sk_test_...
# Clerk Webhook-secret for user.deleted — hent fra Clerk Dashboard: Webhooks → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_...

# Per-utvikler opt-out for cross-env relink dev-gate (kun lokal dev).
# Sett til "true" hvis du deler én Mongo + samme ENCRYPTION_KEY mellom lokal
# dev og prod og vil veksle sømløst uten å rydde relink-state manuelt.
# Ignoreres i produksjon (isProd short-circuit). Cooldown-vernet (10s ping-pong)
# er fortsatt aktivt. La stå kommentert ut hvis du ikke vet hva dette gjør.
# RELINK_DEV_GATE_DISABLED=true

# Krypteringsnøkkel for sensitive data (canvas token, chat) – 64 hex-tegn (32 bytes).
# MÅ genereres med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# validateEnv avviser nøkler med lav entropi (incl. denne placeholder-en) ved oppstart.
ENCRYPTION_KEY=PLACEHOLDER_REPLACE_WITH_GENERATED_HEX_KEY_64_CHARS_LONG_AAAAAAAAAA
# Forrige krypteringsnøkkel (valgfri) – brukes ved nøkkelrotasjon.
# Sett til gammel nøkkel når ENCRYPTION_KEY byttes, slik at eksisterende kryptert
# data (Canvas-tokens, chat-historikk) fortsatt kan dekrypteres.
# Fjern når all data er re-kryptert med ny nøkkel.
# ENCRYPTION_KEY_PREV=
LOG_LEVEL=info
NODE_ENV=development

# AI-tjenester (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Pinecone: vektor-database og Inference (embeddings) – påkrevd. Index-navn f.eks. studywise.
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=studywise

# Cohere Rerank for hybrid søk (rerank-v3.5) - påkrevd
COHERE_API_KEY=...

# LangSmith observability (valgfritt, men anbefalt for tracing av KI-kall)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=studywise

# ─── Web Push / nettleservarsler (valgfritt, men kreves for mobil/nettleser-varsler) ───
# Generer VAPID-nøkler én gang og bruk samme par i backend og frontend.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:kontakt@studwize.page

# Datadog APM (påkrevd i produksjon; kan utelates i dev)
# DD_API_KEY=<din-datadog-api-nøkkel>
# DD_SITE=us5.datadoghq.com
# DD_ENV=production
# DD_APPSEC_ENABLED=true
# DD_APPSEC_SCA_ENABLED=true
# DD_IAST_ENABLED=true
# DD_LOGS_INJECTION=true
# DD_PROFILING_ENABLED=true
# DD_TRACE_SAMPLE_RATE=1
# DD_GIT_REPOSITORY_URL=github.com/26zl/studywise

# ─── Kontaktskjema / Turnstile ───
# Master feature-flag for hele Turnstile-stacken.
# false (default): widgets vises ikke, ingen verifisering, ingen feilmeldinger.
#                  Clerk + ratelimit + honeypot beskytter alene.
# true:            full håndhevelse — krever da alle TURNSTILE_*-vars under.
TURNSTILE_ENABLED=false

# Følgende kreves KUN når TURNSTILE_ENABLED=true:
# Cloudflare Turnstile – server-side secret key fra Turnstile Dashboard
TURNSTILE_SECRET_KEY=0x...

# Egen auth-Turnstile for sign-in/sign-up og signert auth-cookie
AUTH_TURNSTILE_SECRET_KEY=0x...
AUTH_TURNSTILE_GATE_SECRET=<generer-med-crypto.randomBytes(32).toString('hex')>

# Kontakttransport – videresender meldinger til ekstern worker/webhook
# Sett opp Cloudflare Worker eller annen endpoint som mottar POST med JSON-payload.
CONTACT_WORKER_URL=https://contact-worker.example.workers.dev
CONTACT_WORKER_SECRET=<generer-med-crypto.randomBytes(32).toString('hex')>
CONTACT_TO_EMAIL=kontakt@studwize.page
CONTACT_FROM_EMAIL=noreply@studwize.page
